APP_NAME="Seven Tech Trivia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trivia.tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seventech_trivia
DB_USERNAME=seventech_user
DB_PASSWORD="REEMPLAZAR_PASSWORD_SEGURO_MYSQL"

# En VPS Dedicado (Ubuntu + Nginx + PHP-FPM 8.3 + Redis) usar redis para sesiones y caché
SESSION_DRIVER=redis
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# IP del proxy inverso Nginx local (o lista separada por comas si usas balanceador/Cloudflare)
TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Hash bcrypt obligatorio en producción para entrar a /admin
# Genéralo en terminal con: php artisan tinker --execute="echo Hash::make('TuClaveAdmin');"
# Ponlo SIEMPRE entre comillas simples ('...') para que los signos $ no se pierdan
ADMIN_PASSWORD_HASH='$2y$12$REEMPLAZAR_CON_TU_HASH_BCRYPT'
